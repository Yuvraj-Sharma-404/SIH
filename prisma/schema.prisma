datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  phone        String?
  name         String
  role         String    @default("CITIZEN") // CITIZEN, GOVERNMENT_OFFICIAL, UNIVERSITY_MEMBER, INDUSTRY_PARTNER, ADMIN
  organization String?
  designation  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  problems     Problem[] @relation("CitizenProblems")
  feedback     Feedback[]
}

model Problem {
  id                String    @id @default(uuid())
  publicProblemId   String    @unique
  citizenId         String?
  citizen           User?     @relation("CitizenProblems", fields: [citizenId], references: [id])
  reporterName      String?
  reporterPhone     String?
  
  title             String
  description       String
  category          String    @default("Infrastructure") // Infrastructure, Water & Sanitation, Public Health, Education, Environment, Energy, Agriculture
  problemType       String?
  status            String    @default("SUBMITTED") // SUBMITTED, AI_PROCESSED, PENDING_VERIFICATION, VERIFIED, REJECTED, ASSIGNED, UNDER_INVESTIGATION, SOLUTION_REQUIRED, COLLABORATION, SOLUTION_PROPOSED, APPROVED, IMPLEMENTATION, RESOLVED, CLOSED
  
  severity          Float     @default(0.5) // 0.0 to 1.0
  urgency           Float     @default(0.5) // 0.0 to 1.0
  priorityScore     Float     @default(50.0) // 0.0 to 100.0
  
  departmentId      String?
  departmentName    String?
  assignedOfficer   String?
  
  latitude          Float?
  longitude         Float?
  address           String?
  district          String?
  state             String?   @default("Maharashtra")
  
  evidence          Evidence[]
  aiAnalyses        AIAnalysis[]
  priorityAssessments PriorityAssessment[]
  challenges        Challenge[]
  feedback          Feedback[]
  duplicateMatches  DuplicateMatch[] @relation("SourceDuplicates")
  matchedInDuplicates DuplicateMatch[] @relation("MatchedDuplicates")

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Evidence {
  id          String   @id @default(uuid())
  problemId   String
  problem     Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  type        String   // IMAGE, VIDEO, AUDIO, DOCUMENT, TEXT
  fileUrl     String
  fileName    String?
  fileSize    Int?
  mimeType    String?
  createdAt   DateTime @default(now())
}

model AIAnalysis {
  id                    String   @id @default(uuid())
  problemId             String
  problem               Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  provider              String   @default("GEMINI_MOCK") // GEMINI, OPENAI, BHASHINI, LOCAL_MOCK
  summary               String
  extractedCategory     String
  urgencyScore          Float
  severityScore         Float
  recommendedDepartment String
  requiredExpertise     String   // Comma-separated or JSON list
  confidence            Float    @default(0.92)
  rawOutput             String?
  createdAt             DateTime @default(now())
}

model DuplicateMatch {
  id                  String   @id @default(uuid())
  sourceProblemId     String
  sourceProblem       Problem  @relation("SourceDuplicates", fields: [sourceProblemId], references: [id], onDelete: Cascade)
  matchedProblemId    String
  matchedProblem      Problem  @relation("MatchedDuplicates", fields: [matchedProblemId], references: [id], onDelete: Cascade)
  
  semanticScore       Float
  geoDistanceMeters   Float
  categoryMatch       Boolean  @default(true)
  totalDuplicateScore Float    // Combined 0.0 to 1.0
  status              String   @default("SUGGESTED") // SUGGESTED, MERGED, DISMISSED
  createdAt           DateTime @default(now())
}

model PriorityAssessment {
  id               String   @id @default(uuid())
  problemId        String
  problem          Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  totalScore       Float
  populationImpact Float
  severityFactor   Float
  urgencyFactor    Float
  recurrenceFactor Float
  safetyFactor     Float
  explanation      String
  humanOverride    Boolean  @default(false)
  overrideReason   String?
  createdAt        DateTime @default(now())
}

model Challenge {
  id                String    @id @default(uuid())
  problemId         String
  problem           Problem   @relation(fields: [problemId], references: [id], onDelete: Cascade)
  title             String
  description       String
  category          String
  department        String
  requiredExpertise String
  status            String    @default("OPEN") // OPEN, IN_REVIEW, AWARDED, COMPLETED
  budgetEstimate    String?   // e.g. "₹2,50,000"
  deadline          DateTime?
  createdBy         String?
  proposals         Proposal[]
  implementations   Implementation[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Team {
  id           String     @id @default(uuid())
  name         String
  institution  String     // University / College name
  leadName     String
  leadEmail    String
  leadPhone    String?
  skills       String     // e.g. "IoT, Embedded C, Civil Engineering, AI"
  proposals    Proposal[]
  createdAt    DateTime   @default(now())
}

model Proposal {
  id                 String          @id @default(uuid())
  challengeId        String
  challenge          Challenge       @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  teamId             String
  team               Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  title              String
  description        String
  technicalApproach  String
  prototypeUrl       String?
  researchUrl        String?
  estimatedCost      String
  expectedImpact     String
  status             String          @default("SUBMITTED") // SUBMITTED, UNDER_EVALUATION, SHORTLISTED, ACCEPTED, REJECTED
  evaluations        Evaluation[]
  implementation     Implementation?
  createdAt          DateTime        @default(now())
}

model Evaluation {
  id                  String   @id @default(uuid())
  proposalId          String
  proposal            Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  reviewerName        String
  feasibilityScore    Float    // 1 to 10
  scalabilityScore    Float    // 1 to 10
  innovationScore     Float    // 1 to 10
  technicalViability  Float    // 1 to 10
  overallScore        Float    // 1 to 10
  comments            String
  createdAt           DateTime @default(now())
}

model Implementation {
  id                 String        @id @default(uuid())
  proposalId         String        @unique
  proposal           Proposal      @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  challengeId        String
  challenge          Challenge     @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  title              String
  status             String        @default("IN_PROGRESS") // NOT_STARTED, IN_PROGRESS, TESTING, DEPLOYED, COMPLETED
  progressPercentage Int           @default(0)
  milestones         Milestone[]
  impactRecords      ImpactRecord[]
  startedAt          DateTime      @default(now())
  completedAt        DateTime?
}

model Milestone {
  id               String         @id @default(uuid())
  implementationId String
  implementation   Implementation @relation(fields: [implementationId], references: [id], onDelete: Cascade)
  title            String
  description      String
  orderIndex       Int            @default(1)
  dueDate          DateTime?
  status           String         @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  proofEvidenceUrl String?
  completedAt      DateTime?
}

model ImpactRecord {
  id                  String         @id @default(uuid())
  implementationId    String
  implementation      Implementation @relation(fields: [implementationId], references: [id], onDelete: Cascade)
  problemTitle        String
  peopleImpacted      Int            @default(1200)
  metricsSummary      String
  verifiedBy          String
  beforeAfterProofUrl String?
  verifiedAt          DateTime       @default(now())
}

model Feedback {
  id                  String   @id @default(uuid())
  problemId           String
  problem             Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  citizenId           String?
  citizen             User?    @relation(fields: [citizenId], references: [id])
  rating              Int      @default(5) // 1 to 5
  comments            String?
  isResolvedConfirmed Boolean  @default(true)
  createdAt           DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(uuid())
  entityType  String
  entityId    String
  action      String   // e.g. "PROBLEM_VERIFIED", "DUPLICATES_MERGED", "CHALLENGE_CREATED"
  performedBy String
  details     String?
  createdAt   DateTime @default(now())
}
