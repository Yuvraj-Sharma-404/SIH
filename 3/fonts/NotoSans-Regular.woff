<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">
    <title>404</title>
    <style>
        * {
            margin: 0;
            padding: 0;
        }
        body {
            font-family: 'DM Sans', sans-serif;
        }
        .error-container {
            padding-top: 100px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding-left: 15px;
            padding-right: 15px;
        }
        .error-container h2, .error-container p {
            text-align: center;
        }
        .error-container h2 {
            font-size: 24px;
            color: #1a1a1a;
            margin-bottom: 10px;
        }
        .error-container p {
            font-size: 16px;
            color: #4C4C4C;
        }
        .error-container img {
            height: auto;
            margin-bottom: 30px;
        }
        @media (max-width:360px) {
            .error-container img {
                height: auto;
                width: 100%;
                margin-bottom: 15px;
            }
            .error-container h2 {
                font-size: 18px;
            }
            .error-container p {
                font-size: 14px;
                color: #4C4C4C;
            }
        }
    </style>
</head>
<body>
    <div class="error-container">
        <img src="https://media.umangapp.in/cdn/dept/404.svg" alt="404" width="250px" height="174px">
        <h2>Error 404</h2>
        <p>Sorry, but the page your are looking for was either not found or does not exist.</p>
    </div>
</body>
</html>